# ---- PUBLIC (exposed to browser) ----

NEXT_PUBLIC_MAIL_ID=info@payfixadvisors.in
NEXT_PUBLIC_CONTACT_NUMBER=918680939401

# Optional: external HR/admin portal URL. If unset, the footer hides the link.
NEXT_PUBLIC_HR_PORTAL_URL=

# ---- ANALYTICS (all optional — empty value = tag not rendered) ----

# Google Analytics 4 measurement ID. Get from https://analytics.google.com
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=

# Google Tag Manager container ID. Get from https://tagmanager.google.com
# When set, GTM replaces direct GA4 loading (GTM should manage GA4).
# Format: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# Meta (Facebook + Instagram) Pixel ID. Get from Meta Events Manager.
# Format: 15-16 digit number.
NEXT_PUBLIC_META_PIXEL_ID=

# LinkedIn Insight Tag Partner ID. Get from LinkedIn Campaign Manager
# (Account assets → Insight Tag).
# Format: 7-8 digit number.
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# (Optional) LinkedIn Conversion ID for tracking lead-form submissions.
# Configure per-campaign in LinkedIn Campaign Manager → Conversions.
# Format: numeric.
NEXT_PUBLIC_LINKEDIN_CONVERSION_ID=

# ---- ANTI-SPAM (Cloudflare Turnstile, optional but recommended) ----

# Public site key from https://dash.cloudflare.com → Turnstile → Add Site.
# When unset, the captcha widget is not rendered and the server skips
# verification. Set BOTH this and TURNSTILE_SECRET to enable enforcement.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-side secret from the same Turnstile site. Never expose to browser.
TURNSTILE_SECRET=

# ---- LEGAL / BUSINESS IDENTIFIERS (shown in footer, optional) ----

# Goods & Services Tax Identification Number (15 chars, state-prefixed).
NEXT_PUBLIC_GST_NUMBER=

# Corporate Identification Number (only if registered as Pvt Ltd / LLP).
NEXT_PUBLIC_CIN_NUMBER=

# UDYAM (MSME) registration number.
NEXT_PUBLIC_MSME_NUMBER=

# ---- SITE VERIFICATION (for ads + Search Console) ----

# Meta Business Manager → Brand Safety → Domains → Add Domain →
# Meta-tag verification → copy the content="..." value (NOT the
# whole <meta> tag, just the value between the quotes).
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=

# Google Search Console → Add Property → HTML tag method → copy
# the content="..." value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---- SERVER ONLY ----

# Resend API key (https://resend.com → API Keys).
MAIL_SEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxx

# Destination address for inbound leads (verified inbox you actively monitor).
MAIL_TO_ADDRESS=info@payfixadvisors.in

# Verified Resend sender. Must come from a domain you have verified in
# Resend with SPF + DKIM. Format: "Display Name <addr@yourdomain.com>".
MAIL_FROM_ADDRESS=Payfix Advisors <leads@payfixadvisors.in>

# Backend service URL (https). When set, every successful contact submission
# is forwarded to the payfix-backend for DB persistence.
BACKEND_URL=https://api.payfixadvisors.in

# Shared secret with the backend (must match BACKEND_INTERNAL_KEY in the
# backend's env). Send in the x-internal-key header.
BACKEND_INTERNAL_KEY=
